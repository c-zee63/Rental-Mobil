rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Single user (owner-operator): hanya user yang sudah login boleh baca/tulis.
    // Tips: matikan pendaftaran publik di Firebase Console > Authentication,
    // lalu buat 1 akun owner secara manual.
    match /vehicles/{id}   { allow read, write: if request.auth != null; }
    match /customers/{nik} { allow read, write: if request.auth != null; }
    match /bookings/{id}   { allow read, write: if request.auth != null; }
    match /handovers/{id}  { allow read, write: if request.auth != null; }
    match /expenses/{id}   { allow read, write: if request.auth != null; }
    match /images/{id}     { allow read, write: if request.auth != null; } // foto KTP/SIM/nota
    match /settings/{id}   { allow read, write: if request.auth != null; } // profil usaha & logo

    match /{document=**} { allow read, write: if false; }
  }
}
